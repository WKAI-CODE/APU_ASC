    //report 1 - appointment status summary
    
    public void appointmentStatusReport(){
        
        ArrayList<String> appointments = FileHandler.readFile(APPOINTMENT_FILE);
        
        DecimalFormat df = new DecimalFormat("0.00");
        
        int booked = 0;
        int completed = 0;
        int cancelled = 0;
        
        for(String line : appointments){
            
            String[] data = line.split("\\|", -1);
            
            /*
            * appointments.txt:
            *
            * 0 Appointment ID
            * 1 Customer ID
            * 2 Car ID
            * 3 Technician ID
            * 4 Counter Staff ID
            * 5 Service Type
            * 6 Date
            * 7 Start Time
            * 8 End Time
            * 9 Service Price
            * 10 Appointment Status
            * 11 Payment Status
            */
            
            if (data.length >= 12){
                
                String status = data[10];
                
                if (status.equals("BOOKED")){
                    booked++;
                
                }else if (status.equals("COMPLETED")){
                    completed++;
                
                }else if (status.equals("CANCELLED")){
                    cancelled++;
                }
            
            }
        
        }
        int total = booked + completed + cancelled;
        
        System.out.println("\n===== APPOINTMENT STATUS SUMMARY =====");
        
        System.out.println("Total Appointments: " + total);
        System.out.println("BOOKED: " + booked);
        System.out.println("COMPLETED: " + completed);
        System.out.println("CANCELLED: " + cancelled);
        
        if(total > 0){
            
            double completionRate = completed*100.0 / total;
            
            double cancellationRate = cancelled * 100.0 / total;
            
            System.out.println("Completion Rate: " + df.format(completionRate) + "%");
            
            System.out.println("Cancellation Rate: " + df.format(cancellationRate) + "%");
            
            
        
        }
        
        
    
    }
    
    
    //report 2 - minor and major service analysis
    
    public void serviceAnalysisReport(){
        
        ArrayList<String> appointments = FileHandler.readFile(APPOINTMENT_FILE);
        
        DecimalFormat df = new DecimalFormat("0.00");
        
        int minor = 0;
        int major = 0;
        
        for (String line : appointments){
            
            String[] data = line.split("\\|" , -1);
            
            if (data.length >= 12){
                
                if (data[5].equals("MINOR")){
                    
                    minor ++;
                
                }else if (data[5].equals("MAJOR")){
                    
                    major ++;
                
                }
            
            }
        
        }
        
        //calculate total service
        
        int total = minor + major;
        
        //displat report
        System.out.println("\n===== SERVICE ANALYSIS =====");
        
        System.out.println("MINOR Services: " + minor);
        
        System.out.println("MAJOR Services " + major);
        
        System.out.println("Total Services " + total);
        
        
        //calculate percentage
        
        if (total > 0);{
        
        double minorPercentage = minor * 100.0 / total;
        
        double majorPercentage = major * 100.0 / total;
        
        System.out.println("MINOR Percentage: " + df.format(minorPercentage) + "%");
        
        System.out.println("MAJOR Percentage" + df.format(majorPercentage) + "%");
    
    }
    
    }
    
    
    //report 3 - revenue report
    
    public void revenueReport(){
        
        ArrayList<String> appointments = FileHandler.readFile(APPOINTMENT_FILE);
        
        ArrayList<String> payments = FileHandler.readFile(PAYMENT_FILE);
        
        DecimalFormat df = new DecimalFormat("0.00");
        
        double paidRevenue = 0.0;
        double unpaidAmount = 0.0;
        
        int paidCount = 0;
        int unpaidCount = 0;
        
        
        
         /*
        * appointments.txt:
        *
        * 0 Appointment ID
        * 1 Customer ID
        * 2 Car ID
        * 3 Technician ID
        * 4 Counter Staff ID
        * 5 Service Type
        * 6 Date
        * 7 Start Time
        * 8 End Time
        * 9 Service Price
        * 10 Appointment Status
        * 11 Payment Status
        *
        *
        * payments.txt:
        *
        * 0 Payment ID
        * 1 Appointment ID
        * 2 Amount
        * 3 Payment Method
        * 4 Payment Date
        * 5 Counter Staff ID
        */
         
         
        //Check every appointments
        
        for (String appointmentLine : appointments){
            
            String[] appointmentData = appointmentLine.split("\\|" , -1);
            
            if (appointmentData.length < 12){
                continue;
            
            }
            
            String appointmentID = appointmentData[0];
             
            String paymentStatus = appointmentData[1];
            
            double amount = 0.0;
            
            boolean paymentFound = false;
            
            //Fine matching payment
            
            for (String paymentLine : payments){
                
                String[] paymentData = paymentLine.split("\\|" , -1);
                
                if (paymentData.length >= 6 && paymentData[1].equals(appointmentID)){
                    
                    try{
                        
                        amount = Double.parseDouble(paymentData[2]);
                        
                        paymentFound = true;
                    
                    }catch(NumberFormatException e){
                        
                        System.out.println("Invalid payment amount for Appointment ID" + appointmentID);
                    
                    }
                    
                    break;
                
                }
                
            
            }
            
            //PAID
            if (paymentStatus.equals("PAID")){
                
                if(paymentFound){
                    
                    paidRevenue += amount;
                
                }
                
                paidCount++;
            
            }
            
            
            //UNPAID
            else if (paymentStatus.equals("UNPAID")){
                
                try{
                    //use service price from appointment.txt for unpaid appointment
                    
                    amount = Double.parseDouble(appointmentData[9]);
                    
                    unpaidAmount += amount;
                
                }catch(NumberFormatException e){
                    
                    System.out.println("Invalid service price for AppointmentID: " + appointmentID);
                
                }
                
                unpaidCount++;
            
            }
        }
        
        
        //Display report
        
