    //4, DELETE STAFF
    
    public void deleteStaff(){
        
        ArrayList <String> users = FileHandler.readFile(USER_FILE);
        ArrayList <String> staff = FileHandler.readFile(STAFF_FILE);
        
        System.out.println("\n=================================");
        System.out.println("          DELETE STAFF");
        System.out.println("=================================");
        
        System.out.print("Enter user ID to delete");
        
        String userID = sc.nextLine();
        
        boolean found = false;
        
        //Remove from users.txt
        for (int i = 0 ; i < users.size() ; i++){
            
            String[] userData = users.get(i).split("\\|" , -1);
            
            if (userData.length >= 6 && userData[0].equals(userID)){
                
                users.remove(i);
                
                found = true;
                break;
            
            
            }
        
        }
        
        //remove from staff.txt
        if (found){
            
            for (int i = 0 ; i < staff.size() ; i++){
            
            String[] staffData = staff.get(i).split("\\|" , -1);
            
            if(staffData.length >= 5 && staffData[0].equals(userID)){
                
                staff.remove(i);
                break;
            
            }
        
        
        }
            
            //save both files
            FileHandler.writeFile(USER_FILE, users);
            FileHandler.writeFile(STAFF_FILE, staff);
        
            System.out.println("Staff deleted successfully");

            
        
        }else{
            
            System.out.println("Staff not found");
        
        }
        
    
    }
    
    
    
    
    //5. SET SERVICE PRICE
    
    public void setServicePrice(){
        
        System.out.println("\n=================================");
        System.out.println("        SET SERVICE PRICE");
        System.out.println("=================================");
        
        double minorPrice;
        double majorPrice;
        
        DecimalFormat df = new DecimalFormat("0.00");
        
        //MINOR SERVICE
        while(true){
            
            System.out.print("Enter MINOR service price (1 hour): RM ");
            
            try{
                
                minorPrice = Double.parseDouble(sc.nextLine());
                
                if(minorPrice < 0){
                    
                    System.out.println("Price cannot be negative.");
                    continue;
                
                }
                
                break;
            
            }catch(NumberFormatException e){
                
                System.out.println("Please enter a valid price.");
            
            }
        
        
        }
        
        
        //MAJOR SERVICE
        while(true){
            
            System.out.print("Enter MAJOR service price (3 hours): RM ");
            
            try{
                
                majorPrice = Double.parseDouble(sc.nextLine());
                
                if(majorPrice < 0){
                    
                    System.out.println("Price cannot be negative.");
                    continue;
                
                }
                break;
            
            }catch(NumberFormatException e){
                
                System.out.println("Please enter a valid price.");
                    
            }
        
        }
        
        //create price data
        ArrayList<String> prices = new ArrayList<>();
        
        // Format:
        // serviceType|durationHours|price
        
        prices.add("MINOR|1|" + df.format(minorPrice));
        prices.add("MAJOR|3|" + df.format(majorPrice));
        
        FileHandler.writeFile(SERVICE_PRICE_FILE, prices);
        
        
        System.out.println("\nService prices saved successfully.");
        
        System.out.println("Minor Service: 1 hour - RM" + df.format(minorPrice));
        
        System.out.println("Major Service: 3 hours - RM"+  df.format(majorPrice));
    
    
    }
    
    
    
