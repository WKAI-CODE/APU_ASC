    //report 4 - technician performance
    
    public void technicianPerformanceReport(){
        
        ArrayList<String> users = FileHandler.readFile(USER_FILE);
        
        ArrayList<String> appointments = FileHandler.readFile(APPOINTMENT_FILE);
        
        DecimalFormat df = new DecimalFormat("0.00");
        
        System.out.println("\n===== TECHNICIAN PERFORMANCE =====");
        
        boolean technicianFound = false;
        
        //go through all users
        for(String userLine : users){
            
            String[] userData = userLine.split("\\|" , -1);
            
            /*
            * users.txt format:
            *
            * 0 User ID
            * 1 Username
            * 2 Password
            * 3 Name
            * 4 Phone Number
            * 5 Role
            */
            
            //check if user is a technician
            
            if(userData.length >= 6 && userData[5].equals("Technician")){
                
                technicianFound = true;
                
                String technicianID = userData[0];
                
                String technicianName = userData[3];
                
                int assigned = 0;
                int completed = 0;
                
                
                //check all appointments
                for(String appointmentLine : appointments){
                    
                    String[] appointmentData = appointmentLine.split("\\|" , -1);
                    
                    if(appointmentData.length >= 12 && appointmentData[3].equals(technicianID)){
                        
                        //count assigned appoinment
                        assigned++;
                        
                        //count completed appointment
                        if (appointmentData[10].equals("COMPLETED")){
                            
                            completed++;
                        
                        }
                    
                    }
                
                }
                
                
                //display
                System.out.println("-------------------------");
                System.out.println("Technician ID: " + technicianID);
                System.out.println("Assigned Appointments: " + assigned);
                System.out.println("Completed Appointments: " + completed);
                
                
                //completion rate
                if(assigned > 0){
                    
                    double completionRate = completed * 100.0 / assigned;
                    
                    System.out.println("Completion Rate: " + df.format(completionRate) + "%");
                
                }else{
                    
                    System.out.println("Completion Rate: 0.00%");
                
                }
            
            }
        
        }
        
        if(!technicianFound){
            
            System.out.println("No technicians found");
        
        }
    
    }
        
        
    
        
        
